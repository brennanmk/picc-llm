# This is an example environment file.
# Copy this file to .env (or .env.local, .env.docker) and fill in the values for your environment.
# IMPORTANT: Do NOT commit your actual .env file with secrets to version control.

# A long, random, and secret string used for session signing and cryptographic functions.
# Generate one with: openssl rand -hex 32
SECRET_KEY=your_super_secret_and_long_random_string

# The absolute or relative path where trained models should be stored.
MODEL_STORAGE_DIR=/path/to/your/models

# The absolute or relative path where generated graphs should be stored.
GRAPH_STORAGE_DIR=/path/to/your/graphs

# --- Database Configuration ---
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_strong_database_password
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_NAME=picc